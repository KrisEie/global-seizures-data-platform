# Copy this file to .env at the repository root and choose your own local values.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=drug_seizures
PG_USER=postgres
PG_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB=drug_seizures_db
MONGODB_USER=app
MONGODB_PASSWORD=REPLACE_WITH_LOCAL_MONGODB_PASSWORD
MONGODB_AUTH_SOURCE=admin
# Optional: set MONGODB_URI instead of the separate MongoDB connection fields.
MONGODB_URI=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_LOCAL_NEO4J_PASSWORD
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PORT=5000
BIND_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
